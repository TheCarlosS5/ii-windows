// ii-windows: fastfetch with a compact "ii" as its logo. Uses the terminal's ANSI colours, so it
// follows the scheme ii generates from the wallpaper.
//
// Which config and logo are used is decided by the `fastfetch` command (bin\fastfetch.cmd), in this order:
//   1. what you type: -c <file>, --logo <file|none>, --logo-type ... (nothing of ii's is added for it)
//   2. your own config: the file in %II_FASTFETCH_CONFIG%, or %LOCALAPPDATA%\ii-windows\fastfetch.jsonc
//   3. this file, with ii-logo.txt (or ii-logo-ascii.txt when the terminal cannot show Unicode)
// To change the logo for good, copy this file to %LOCALAPPDATA%\ii-windows\fastfetch.jsonc and edit
// "logo". Picture logos (PNG, sixel, kitty) are options of fastfetch itself and depend on your
// terminal: see https://github.com/fastfetch-cli/fastfetch/wiki/Logo-options
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "ii-logo.txt",
    "color": { "1": "magenta" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "magenta" },
    "key": { "width": 11 }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "────────────────────────────" },
    { "type": "os", "key": "󰍲 os" },
    // The version the `fastfetch` command passes in II_VERSION; "dev" when run by hand.
    { "type": "command", "key": "󰖯 shell", "text": "cmd /c echo illogical impulse · ii-windows %II_VERSION%" },
    { "type": "uptime", "key": "󰅐 uptime" },
    { "type": "display", "key": "󰍹 display" },
    { "type": "terminal", "key": " terminal" },
    { "type": "cpu", "key": "󰻠 cpu" },
    { "type": "gpu", "key": "󰢮 gpu" },
    { "type": "memory", "key": "󰍛 memory" },
    { "type": "disk", "key": "󰋊 disk", "folders": "C:\\" },
    "break",
    "colors"
  ]
}
