{
  "schema": 1,
  "about": "The one list of ii's keyboard actions (U01/U02). tools/dev/gen-actions.py turns it into host/src/shortcuts_table.inc (what ii-host swallows), overlay/ii/services/HyprlandKeybinds.qml (the cheatsheet) and docs/ATAJOS.md; test-actions.ps1 fails if those drift from it or if a shell target has no consumer in the QML. Edit this file, not the outputs.",
  "support": {
    "available": "ii does it.",
    "partial": "ii does part of it, or something close; 'reason' says what is missing.",
    "external": "Windows keeps handling the combination; ii does not touch it, and 'reason' says why.",
    "unsupported": "Nothing happens beyond Windows' own behaviour; kept here so that it is visible, not hidden."
  },
  "actions": [
    { "id": "search-tap", "group": "Shell", "text": "Search apps, files and math (tap the key)", "support": "available",
      "target": { "kind": "pseudo", "name": "searchToggleRelease" }, "keys": [ { "mods": ["win"], "key": "SUPER_L", "swallow": false } ] },
    { "id": "search", "group": "Shell", "text": "Search", "support": "available",
      "target": { "kind": "shell", "name": "searchToggle" }, "keys": [ { "mods": ["win"], "key": "S" } ] },
    { "id": "overview", "group": "Shell", "text": "Overview of open windows", "support": "available",
      "target": { "kind": "shell", "name": "overviewWorkspacesToggle" }, "keys": [ { "mods": ["win"], "key": "Tab" } ] },
    { "id": "windows-navigate", "group": "Shell", "text": "Navigate open windows (the overview)", "support": "partial",
      "reason": "Win+T opens the same overview as Win+Tab; moving through the dock with the keyboard needs the dock navigation of C10.",
      "target": { "kind": "shell", "name": "overviewWorkspacesToggle" }, "keys": [ { "mods": ["win"], "key": "T" } ] },
    { "id": "close-window", "group": "Windows", "text": "Close the window in front (like Alt+F4)", "support": "available",
      "target": { "kind": "host", "name": "@closeWindow" }, "keys": [ { "mods": ["win"], "key": "Q" } ] },
    { "id": "desktops-go", "group": "Desktops", "text": "Go to desktop 1-10 (creates one if it doesn't exist)", "support": "available",
      "target": { "kind": "workspace", "name": "digits" }, "keys": [ { "mods": ["win"], "key": "1-0", "swallow": false } ] },
    { "id": "desktops-move", "group": "Desktops", "text": "Move the window in front to desktop 1-10", "support": "available",
      "target": { "kind": "workspace", "name": "digits-move" }, "keys": [ { "mods": ["win", "shift"], "key": "1-0", "swallow": false } ] },
    { "id": "desktops-prev-next", "group": "Desktops", "text": "Previous / next desktop (Windows)", "support": "external",
      "reason": "Windows' own combination; it works with ii's desktops.",
      "target": { "kind": "windows" }, "keys": [ { "mods": ["win", "ctrl"], "key": "Left/Right", "swallow": false } ] },
    { "id": "desktops-new", "group": "Desktops", "text": "New desktop (Windows)", "support": "external",
      "reason": "Windows' own combination.", "target": { "kind": "windows" }, "keys": [ { "mods": ["win", "ctrl"], "key": "D", "swallow": false } ] },
    { "id": "desktops-close", "group": "Desktops", "text": "Close this desktop (Windows)", "support": "external",
      "reason": "Windows' own combination.", "target": { "kind": "windows" }, "keys": [ { "mods": ["win", "ctrl"], "key": "F4", "swallow": false } ] },
    { "id": "sidebar-left-w", "group": "Shell", "text": "Left sidebar", "support": "available",
      "target": { "kind": "shell", "name": "sidebarLeftToggle" }, "keys": [ { "mods": ["win"], "key": "W" } ] },
    { "id": "sidebar-left-a", "group": "Shell", "text": "Left sidebar", "support": "available",
      "target": { "kind": "shell", "name": "sidebarLeftToggle" }, "keys": [ { "mods": ["win"], "key": "A" } ] },
    { "id": "sidebar-left-o", "group": "Shell", "text": "Left sidebar", "support": "available",
      "target": { "kind": "shell", "name": "sidebarLeftToggle" }, "keys": [ { "mods": ["win"], "key": "O" }], "cheatsheet": false },
    { "id": "tray-focus", "group": "Shell", "text": "Left sidebar", "support": "partial",
      "reason": "Win+B is the left sidebar until the tray can be reached from the keyboard (U06).",
      "target": { "kind": "shell", "name": "sidebarLeftToggle" }, "keys": [ { "mods": ["win"], "key": "B" } ], "cheatsheet": false },
    { "id": "sidebar-left-detach", "group": "Shell", "text": "Left sidebar, detached", "support": "available",
      "target": { "kind": "shell", "name": "sidebarLeftToggleDetach" }, "keys": [ { "mods": ["win", "alt"], "key": "A" } ], "cheatsheet": false },
    { "id": "sidebar-right-alt-d", "group": "Shell", "text": "Right sidebar (calendar)", "support": "available",
      "target": { "kind": "shell", "name": "sidebarRightToggle" }, "keys": [ { "mods": ["win", "alt"], "key": "D" } ] },
    { "id": "sidebar-right-n", "group": "Shell", "text": "Right sidebar (quick settings, notifications)", "support": "available",
      "target": { "kind": "shell", "name": "sidebarRightToggle" }, "keys": [ { "mods": ["win"], "key": "N" } ] },
    { "id": "clipboard", "group": "Shell", "text": "Clipboard history", "support": "available",
      "target": { "kind": "shell", "name": "overviewClipboardToggle" }, "keys": [ { "mods": ["win"], "key": "V" } ] },
    { "id": "emoji", "group": "Shell", "text": "Emoji picker", "support": "available",
      "target": { "kind": "shell", "name": "overviewEmojiToggle" }, "keys": [ { "mods": ["win"], "key": "Period" } ] },
    { "id": "media", "group": "Shell", "text": "Media controls", "support": "available",
      "target": { "kind": "shell", "name": "mediaControlsToggle" }, "keys": [ { "mods": ["win"], "key": "M" } ] },
    { "id": "bar", "group": "Shell", "text": "Show or hide the bar", "support": "available",
      "target": { "kind": "shell", "name": "barToggle" }, "keys": [ { "mods": ["win"], "key": "J" } ] },
    { "id": "osk", "group": "Shell", "text": "On-screen keyboard", "support": "available",
      "target": { "kind": "shell", "name": "oskToggle" }, "keys": [ { "mods": ["win"], "key": "K" } ] },
    { "id": "cheatsheet", "group": "Shell", "text": "This cheatsheet", "support": "available",
      "target": { "kind": "shell", "name": "cheatsheetToggle" }, "keys": [ { "mods": ["win"], "key": "Slash" } ] },
    { "id": "show-desktop", "group": "Shell", "text": "Show desktop (again to restore)", "support": "available",
      "target": { "kind": "host", "name": "@showDesktop" }, "keys": [ { "mods": ["win"], "key": "D" } ] },
    { "id": "restart-shell", "group": "Shell", "text": "Restart ii", "support": "available",
      "target": { "kind": "host", "name": "@restartShell" }, "keys": [ { "mods": ["win", "ctrl"], "key": "R" } ] },
    { "id": "color-picker", "group": "Shell", "text": "Color picker (copies #RRGGBB)", "support": "available",
      "target": { "kind": "host", "name": "@colorPicker" }, "keys": [ { "mods": ["win", "shift"], "key": "C" } ] },
    { "id": "wallpaper-selector", "group": "Shell", "text": "Wallpaper selector", "support": "available",
      "target": { "kind": "shell", "name": "wallpaperSelectorToggle" }, "keys": [ { "mods": ["win", "ctrl"], "key": "T" } ] },
    { "id": "wallpaper-random", "group": "Shell", "text": "Random wallpaper", "support": "available",
      "target": { "kind": "shell", "name": "wallpaperSelectorRandom" }, "keys": [ { "mods": ["win", "ctrl", "alt"], "key": "T" } ] },
    { "id": "light-dark", "group": "Shell", "text": "Toggle light/dark", "support": "available",
      "target": { "kind": "shell", "name": "toggleLightDark" }, "keys": [ { "mods": ["win", "ctrl", "shift"], "key": "D" } ] },
    { "id": "settings", "group": "Shell", "text": "ii settings", "support": "available",
      "target": { "kind": "shell", "name": "settingsOpen" }, "keys": [ { "mods": ["win"], "key": "I" } ] },
    { "id": "run", "group": "Shell", "text": "Run (Windows): programs, commands, folders and links", "support": "external",
      "reason": "Windows' own Run box opens: it runs everything Windows can (cmd, regedit, %appdata%, paths); ii's search is the Win key.",
      "target": { "kind": "windows" }, "keys": [ { "mods": ["win"], "key": "R", "swallow": false } ] },
    { "id": "tools-menu", "group": "Shell", "text": "Session menu (power, sign out, lock)", "support": "partial",
      "reason": "Win+X opens ii's session menu; the system tools menu of Windows (Task Manager, Device Manager...) has no ii counterpart yet.",
      "target": { "kind": "shell", "name": "sessionToggle" }, "keys": [ { "mods": ["win"], "key": "X" } ] },
    { "id": "screenshot", "group": "Screenshot", "text": "Region screenshot", "support": "available",
      "target": { "kind": "shell", "name": "regionScreenshot" }, "keys": [ { "mods": ["win", "shift"], "key": "S" } ] },
    { "id": "screenshot-print", "group": "Screenshot", "text": "Region screenshot (Print Screen)", "support": "available",
      "target": { "kind": "shell", "name": "regionScreenshot" }, "keys": [ { "mods": [], "key": "Print" } ] },
    { "id": "region-translate", "group": "Screenshot", "text": "Translate a region", "support": "available",
      "target": { "kind": "shell", "name": "screenTranslate" }, "keys": [ { "mods": ["win", "shift"], "key": "T" } ] },
    { "id": "region-record", "group": "Screenshot", "text": "Record a region", "support": "partial",
      "reason": "The region is chosen; there is no video encoder behind it yet (C03).",
      "target": { "kind": "shell", "name": "regionRecord" }, "keys": [ { "mods": ["win", "shift"], "key": "R" }, { "mods": ["win", "alt"], "key": "R" } ] },
    { "id": "session-menu", "group": "Session", "text": "Session menu (power, sign out, lock)", "support": "available",
      "target": { "kind": "shell", "name": "sessionToggle" }, "keys": [ { "mods": ["ctrl", "alt"], "key": "End" } ] },
    { "id": "session-alt-f4", "group": "Session", "text": "Session menu, on the desktop", "support": "available",
      "target": { "kind": "pseudo", "name": "sessionToggle" }, "keys": [ { "mods": ["alt"], "key": "F4", "swallow": false } ] },
    { "id": "lock", "group": "Session", "text": "Lock (Windows)", "support": "external",
      "reason": "Windows' lock screen is the only secure one (R03/U08).", "target": { "kind": "windows" }, "keys": [ { "mods": ["win"], "key": "L", "swallow": false } ] },
    { "id": "security-options", "group": "Session", "text": "Security options (Windows)", "support": "external",
      "reason": "Ctrl+Alt+Del never reaches a program.", "target": { "kind": "windows" }, "keys": [ { "mods": ["ctrl", "alt"], "key": "Delete", "swallow": false } ] },
    { "id": "task-manager", "group": "Session", "text": "Task Manager (Windows)", "support": "external",
      "reason": "No process center in ii yet (X03).", "target": { "kind": "windows" }, "keys": [ { "mods": ["ctrl", "shift"], "key": "Escape", "swallow": false } ] },
    { "id": "file-explorer", "group": "Windows", "text": "File Explorer", "support": "external",
      "reason": "No file center in ii yet (X02).", "target": { "kind": "windows" }, "keys": [ { "mods": ["win"], "key": "E", "swallow": false } ] },
    { "id": "display-projection", "group": "Windows", "text": "Display modes (Windows)", "support": "external",
      "reason": "ii's display selector with rollback comes with U05.", "target": { "kind": "windows" }, "keys": [ { "mods": ["win"], "key": "P", "swallow": false } ] },
    { "id": "alt-tab", "group": "Windows", "text": "Switch windows", "support": "external",
      "reason": "ii's own switcher is U03.", "target": { "kind": "windows" }, "keys": [ { "mods": ["alt"], "key": "Tab", "swallow": false } ] },
    { "id": "snap", "group": "Windows", "text": "Maximize / snap", "support": "external",
      "reason": "Windows' own combination.", "target": { "kind": "windows" }, "keys": [ { "mods": ["win"], "key": "Up", "swallow": false } ] },
    { "id": "panic", "group": "Safety", "text": "Panic: restore Windows' taskbar and desktop, stop ii", "support": "available",
      "reason": "A system hotkey of ii-host itself: it works with shortcuts suspended and over games.",
      "target": { "kind": "host", "name": "@panic" }, "keys": [ { "mods": ["ctrl", "alt", "shift"], "key": "R", "swallow": false } ] }
  ]
}
